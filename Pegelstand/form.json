{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "Gauging station",
            "expanded": true,
            "items": [
                {
                    "type": "ValidationTextBox",
                    "name": "WaterFilter",
                    "caption": "Waterway filter (e.g. Rhein, Elbe – empty = all)"
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "Button",
                            "caption": "Apply filter",
                            "onClick": "IPS_RequestAction($id, 'FilterStations', $WaterFilter);"
                        },
                        {
                            "type": "Button",
                            "caption": "Reload station list",
                            "onClick": "IPS_RequestAction($id, 'ReloadStations', $WaterFilter);"
                        }
                    ]
                },
                {
                    "type": "CheckBox",
                    "name": "SortByDistance",
                    "caption": "Sort by distance from my location"
                },
                {
                    "type": "Label",
                    "name": "StationListError",
                    "caption": "",
                    "visible": false
                },
                {
                    "type": "Select",
                    "name": "StationUUID",
                    "caption": "Gauging station",
                    "width": "600px",
                    "options": []
                },
                {
                    "type": "ValidationTextBox",
                    "name": "StationManual",
                    "caption": "or enter the station directly (name like KONSTANZ or UUID – used when nothing is selected above)",
                    "width": "600px"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Update & trend",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "Interval",
                    "caption": "Measurement cycle of the station",
                    "suffix": "minutes",
                    "minimum": 5,
                    "maximum": 1440
                },
                {
                    "type": "Label",
                    "caption": "Data is fetched shortly after the next measurement is expected. If it is not there yet, it is checked again after 3 minutes. Values are only recalculated when new data arrives."
                },
                {
                    "type": "NumberSpinner",
                    "name": "TrendHours",
                    "caption": "Period for the trend",
                    "suffix": "hours",
                    "minimum": 1,
                    "maximum": 48
                },
                {
                    "type": "NumberSpinner",
                    "name": "TrendThreshold",
                    "caption": "Threshold for rising/falling",
                    "suffix": "cm",
                    "digits": 1,
                    "minimum": 0
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Additional functions",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "ShowTimestamp",
                    "caption": "Show time of measurement"
                },
                {
                    "type": "CheckBox",
                    "name": "ShowStationInfo",
                    "caption": "Show station info (waterway, station, river km, gauge zero)"
                },
                {
                    "type": "CheckBox",
                    "name": "ShowCharacteristics",
                    "caption": "Show reference values (MNW, MW, MHW, HSW … – depending on station)"
                },
                {
                    "type": "CheckBox",
                    "name": "ShowFloodWarning",
                    "caption": "Show state and flood warning"
                },
                {
                    "type": "NumberSpinner",
                    "name": "WarnLevel",
                    "caption": "Own warning threshold (0 = WSV HSW only)",
                    "suffix": "cm",
                    "minimum": 0
                },
                {
                    "type": "CheckBox",
                    "name": "ShowDischarge",
                    "caption": "Show discharge (Q) – only for stations measuring discharge"
                },
                {
                    "type": "CheckBox",
                    "name": "ShowInsights",
                    "caption": "Create assessment and forecast as variables (e.g. “23 cm below mean water level”, “warning threshold in approx. 6 h”)"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Notifications",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "NotifyEnabled",
                    "caption": "Send push notification on flood warning"
                },
                {
                    "type": "SelectInstance",
                    "name": "NotifyTarget",
                    "caption": "Visualization (tile visualization or WebFront)",
                    "width": "400px"
                },
                {
                    "type": "NumberSpinner",
                    "name": "NotifyHysteresis",
                    "caption": "Hysteresis for the all clear",
                    "suffix": "cm",
                    "digits": 1,
                    "minimum": 0
                },
                {
                    "type": "CheckBox",
                    "name": "NotifyClear",
                    "caption": "Also notify when the warning ends"
                },
                {
                    "type": "Label",
                    "caption": "Triggered when the WSV reports “above HSW” or at your own warning threshold (additional functions). The warning ends only once the level is below it by the hysteresis."
                },
                {
                    "type": "Button",
                    "caption": "Send test message",
                    "onClick": "PEGEL_TestNotification($id);"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Archive",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "ArchiveEnabled",
                    "caption": "Archive water level (and discharge) and load history on first query"
                },
                {
                    "type": "NumberSpinner",
                    "name": "ArchiveBackfillDays",
                    "caption": "Load the last",
                    "suffix": "days",
                    "minimum": 1,
                    "maximum": 30
                },
                {
                    "type": "Button",
                    "caption": "Load history into archive now",
                    "onClick": "$n = PEGEL_BackfillArchive($id); echo $n >= 0 ? $n . ' Werte nachgeladen.' : 'Nachladen fehlgeschlagen (siehe Debug).';"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Tile",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "UseTile",
                    "caption": "Use own tile with water animation"
                },
                {
                    "type": "Select",
                    "name": "TileTheme",
                    "caption": "Color scheme",
                    "options": [
                        {
                            "caption": "Symcon design – colors of the visualization",
                            "value": 3
                        },
                        {
                            "caption": "Nature – sky by time of day",
                            "value": 0
                        },
                        {
                            "caption": "Dark",
                            "value": 1
                        },
                        {
                            "caption": "Light",
                            "value": 2
                        }
                    ]
                },
                {
                    "type": "Select",
                    "name": "TileLayout",
                    "caption": "Layout",
                    "options": [
                        {
                            "caption": "Automatic (ring on small tiles)",
                            "value": 0
                        },
                        {
                            "caption": "Always water scene",
                            "value": 1
                        },
                        {
                            "caption": "Always level ring",
                            "value": 2
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "SelectMedia",
                            "name": "TileBackground",
                            "caption": "Own background image (optional)"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "TileBackgroundDim",
                            "caption": "Darken",
                            "suffix": "%",
                            "minimum": 0,
                            "maximum": 90
                        }
                    ]
                },
                {
                    "type": "CheckBox",
                    "name": "TileShowRefs",
                    "caption": "Draw reference lines (MNW, MW, MHW, HSW, own warning threshold)"
                },
                {
                    "type": "CheckBox",
                    "name": "TileShowHistory",
                    "caption": "Show history line in the background"
                },
                {
                    "type": "NumberSpinner",
                    "name": "TileHistoryHours",
                    "caption": "Period of the history line",
                    "suffix": "hours",
                    "minimum": 1,
                    "maximum": 720
                },
                {
                    "type": "CheckBox",
                    "name": "TileShowStaff",
                    "caption": "Gauge staff with cm scale at the edge"
                },
                {
                    "type": "CheckBox",
                    "name": "TileEffects",
                    "caption": "Current matching the trend, rain during floods"
                },
                {
                    "type": "CheckBox",
                    "name": "TileSkyObjects",
                    "caption": "Sun, moon (with real moon phase) and drifting clouds"
                },
                {
                    "type": "CheckBox",
                    "name": "TileShowBoat",
                    "caption": "Ship on the water (at anchor when navigation is suspended above HSW)"
                },
                {
                    "type": "CheckBox",
                    "name": "TileShowFish",
                    "caption": "Fish school in the water"
                },
                {
                    "type": "CheckBox",
                    "name": "TileShowWhale",
                    "caption": "Whale passing by now and then"
                },
                {
                    "type": "CheckBox",
                    "name": "TileShowInsights",
                    "caption": "Assessment in words and forecast in the tile"
                },
                {
                    "type": "CheckBox",
                    "name": "TileReduceMotion",
                    "caption": "Reduce animations (for older wall tablets)"
                },
                {
                    "type": "Label",
                    "caption": "Tapping the tile opens the detail view with chart, min/max and reference values."
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Update now",
            "onClick": "PEGEL_Update($id);"
        },
        {
            "type": "Label",
            "caption": "Several stations: create one instance per station – easiest via the “Pegelstand Konfigurator”."
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Water level is being queried"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Please select a gauging station"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "PEGELONLINE not reachable or invalid response"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "Gauging station not found"
        },
        {
            "code": 203,
            "icon": "error",
            "caption": "Station delivers no current water level"
        }
    ]
}