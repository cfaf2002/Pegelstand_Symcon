{
    "elements": [
        {
            "type": "Select",
            "name": "Water",
            "caption": "Waterway",
            "width": "400px",
            "options": []
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "KmFrom",
                    "caption": "from river km",
                    "digits": 1,
                    "minimum": 0
                },
                {
                    "type": "NumberSpinner",
                    "name": "KmTo",
                    "caption": "to river km (0 = to the end)",
                    "digits": 1,
                    "minimum": 0
                }
            ]
        },
        {
            "type": "NumberSpinner",
            "name": "MaxStations",
            "caption": "Show at most this many stations",
            "minimum": 2,
            "maximum": 30
        },
        {
            "type": "CheckBox",
            "name": "HideLockUpper",
            "caption": "Hide lock upper gauges (OP) – they are dam-controlled and show no wave"
        },
        {
            "type": "CheckBox",
            "name": "HideNoReference",
            "caption": "Hide stations without reference values (e.g. tidal gauges) – they cannot be placed in the band"
        },
        {
            "type": "NumberSpinner",
            "name": "Interval",
            "caption": "Query interval",
            "suffix": "minutes",
            "minimum": 5,
            "maximum": 1440
        },
        {
            "type": "Select",
            "name": "TileTheme",
            "caption": "Tile color scheme",
            "options": [
                {
                    "caption": "Symcon design – colors of the visualization",
                    "value": 2
                },
                {
                    "caption": "Dark",
                    "value": 0
                },
                {
                    "caption": "Light",
                    "value": 1
                }
            ]
        },
        {
            "type": "CheckBox",
            "name": "TileReduceMotion",
            "caption": "Reduce animations (for older wall tablets)"
        },
        {
            "type": "Label",
            "caption": "Each column shows the level relative to the station’s own reference values: mean low water (MNW) at the bottom, mean high water (MHW) at the top. This makes stations with very different gauge zeros comparable and reveals a flood wave."
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Update now",
            "onClick": "PEGELFB_Update($id);"
        },
        {
            "type": "Button",
            "caption": "Reload waterway list",
            "onClick": "IPS_RequestAction($id, 'ReloadWaters', '');"
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "River band is being updated"
        },
        {
            "code": 104,
            "icon": "inactive",
            "caption": "Please select a waterway"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "PEGELONLINE not reachable or invalid response"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "No stations with water level in the selected section"
        }
    ]
}