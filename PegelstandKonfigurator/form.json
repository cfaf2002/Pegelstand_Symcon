{
    "elements": [
        {
            "type": "ValidationTextBox",
            "name": "WaterFilter",
            "caption": "Waterway filter (e.g. Rhein, Elbe – empty = all)"
        },
        {
            "type": "NumberSpinner",
            "name": "MaxDistance",
            "caption": "Radius around my location (0 = all)",
            "suffix": "km",
            "minimum": 0,
            "maximum": 1000
        },
        {
            "type": "Label",
            "caption": "Apply the filter with “Apply changes”. Stations already created are always shown. With a location set in Symcon, the list is sorted by distance."
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Reload list and levels",
            "onClick": "IPS_RequestAction($id, 'Reload', '');"
        },
        {
            "type": "Label",
            "caption": "The list is cached for 10 minutes so the form opens quickly."
        },
        {
            "type": "Configurator",
            "name": "Stations",
            "caption": "Gauging stations (PEGELONLINE)",
            "rowCount": 20,
            "add": false,
            "delete": true,
            "sort": {
                "column": "water",
                "direction": "ascending"
            },
            "columns": [
                {
                    "caption": "Station",
                    "name": "name",
                    "width": "auto"
                },
                {
                    "caption": "Waterway",
                    "name": "water",
                    "width": "180px"
                },
                {
                    "caption": "Distance (km)",
                    "name": "distance",
                    "width": "130px"
                },
                {
                    "caption": "Current level",
                    "name": "level",
                    "width": "130px"
                },
                {
                    "caption": "River km",
                    "name": "km",
                    "width": "90px"
                },
                {
                    "caption": "Operator",
                    "name": "agency",
                    "width": "220px"
                }
            ],
            "values": []
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Station list loaded"
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "PEGELONLINE not reachable or invalid response"
        }
    ]
}